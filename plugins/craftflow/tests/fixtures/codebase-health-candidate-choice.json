{
  "id": "codebase-health-candidate-choice",
  "workflow_type": "CODEBASE-HEALTH",
  "scenarios": [
    {
      "name": "candidates-found-choice-grill-terminal-plan-handoff",
      "request": "run a codebase health check on calc",
      "just_go": false,
      "expected": {"path": "handoff", "candidate_picked": 1, "child_minted": true},
      "steps": [
        {"op": "announce", "text": "-> CODEBASE-HEALTH workflow (signals: codebase health)"},
        {"op": "mint", "workflow_type": "CODEBASE-HEALTH", "phase": "codebase-health"},
        {"op": "scanner", "status": "CANDIDATES_FOUND", "candidate_count": 2, "strengths": ["Strong", "Worth exploring"], "top": 1, "report_exists": true, "outcome": "ok"},
        {"op": "report_shown", "how": "open", "platform": "darwin"},
        {"op": "gate", "pending_gate": "candidate_choice"},
        {"op": "question", "options": ["1", "2", "None"]},
        {"op": "answer", "text": "1", "outcome": "picked"},
        {"op": "grill", "candidate": 1, "pending_gate": "candidate_choice"},
        {"op": "design_saved", "path": "docs/plans/2026-10-30-calc-facade-design.md", "captured_in": "results.codebase_health.design_file"},
        {"op": "status", "value": "completed"},
        {"op": "memory_task_created"},
        {"op": "memory_finalized"},
        {"op": "handoff", "target": "PLAN", "input_kind": "design", "announce": "-> handing off to PLAN (design: docs/plans/2026-10-30-calc-facade-design.md)"}
      ]
    },
    {
      "name": "no-candidates-completes-without-a-gate-or-handoff",
      "request": "improve architecture of the billing module",
      "just_go": false,
      "expected": {"path": "completed_no_handoff", "child_minted": false},
      "steps": [
        {"op": "announce", "text": "-> CODEBASE-HEALTH workflow (signals: improve architecture)"},
        {"op": "mint", "workflow_type": "CODEBASE-HEALTH", "phase": "codebase-health"},
        {"op": "scanner", "status": "NO_CANDIDATES", "candidate_count": 0, "strengths": [], "top": null, "report_exists": true, "outcome": "ok"},
        {"op": "report_shown", "how": "print", "platform": "linux"},
        {"op": "status", "value": "completed"},
        {"op": "memory_task_created"},
        {"op": "memory_finalized"}
      ]
    },
    {

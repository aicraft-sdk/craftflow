{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Craftflow agent output contract schema. Enforced by craftflow_contract_validate.py. Per-kind overlays add required fields on top of the base.",
  "definitions": {
    "memory_note_item": {
      "oneOf": [
        {"type": "string"},
        {
          "type": "object",
          "required": ["text"],
          "properties": {
            "text": {"type": "string"},
            "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0}
          }
        }
      ]
    },
    "memory_notes": {
      "type": "object",
      "properties": {
        "learnings": {"type": "array", "items": {"$ref": "#/definitions/memory_note_item"}},
        "patterns":  {"type": "array", "items": {"$ref": "#/definitions/memory_note_item"}},
        "verification": {"type": "array", "items": {"type": "string"}},
        "deferred":  {"type": "array", "items": {"type": "string"}},
        "retractions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "gap_classification_item": {
      "type": "object",
      "required": ["type", "severity"],
      "properties": {
        "type": {"type": "string", "enum": ["Missing", "Partial", "Contradicts", "Unrequested"]},
        "severity": {"type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]},
        "description": {"type": "string"}
      }
    },
    "base_contract": {
      "type": "object",
      "required": ["STATUS"],
      "properties": {
        "STATUS": {"type": "string", "enum": ["COMPLETE","PASS","BLOCKED","SKIPPED","FAIL","FIXED","INVESTIGATING","PLAN_CREATED","DECISION_RFC_CREATED","NEEDS_CLARIFICATION","PARTIAL","DEGRADED","UNAVAILABLE"]},
        "BLOCKING": {"type": "boolean"},
        "USER_INPUT_NEEDED": {"type": "boolean"},
        "MEMORY_NOTES": {"$ref": "#/definitions/memory_notes"}
      }
    }
  },
  "kind_overlays_comment": "Keys in kind_overlays are real agent_type slugs (the string after 'craftflow:'), matching craftflow_contract_validate.py's REQUIRED_FIELDS exactly (checked by the structural cross-check test in tests/fixtures/test_contract_validate.py). 'verifier'/'reviewer' are deliberately kept as free-standing, permanently unreachable kind names -- the read-only agents using this contract shape (integration-verifier, code-reviewer, doubt-verifier, plan-gap-reviewer, silent-failure-hunter) emit the envelope+heading shape, not the YAML-block heading this schema applies to.",
  "kind_overlays": {
    "component-builder": {
      "required_fields": ["STATUS","SUMMARY","CONFIDENCE","PHASE_ID","PHASE_STATUS","PHASE_EXIT_READY","PROOF_STATUS","TDD_RED_EXIT","TDD_GREEN_EXIT","SCENARIOS","BLOCKING","REMEDIATION_NEEDED"]
    },
    "verifier": {
      "required_fields": ["STATUS","SCENARIOS","BLOCKING","REMEDIATION_NEEDED"],
      "required_evidence_fields": ["VERIFICATION"],
      "optional_fields": {"GAP_CLASSIFICATION": {"items": {"$ref": "#/definitions/gap_classification_item"}}}
    },
    "reviewer": {
      "required_fields": ["STATUS","BLOCKING","REMEDIATION_NEEDED"]
    },
    "planner": {
      "required_fields": ["STATUS","SUMMARY","PLAN_FILE","PLAN_MODE","CONFIDENCE","GATE_PASSED","OPEN_DECISIONS","SCENARIOS","BLOCKING","REMEDIATION_NEEDED"]
    },
    "bug-investigator": {
      "required_fields": ["STATUS","SUMMARY","ROOT_CAUSE","TDD_RED_EXIT","TDD_GREEN_EXIT","BLOCKING","REMEDIATION_NEEDED"]
    },
    "doc-syncer": {
      "required_fields": ["STATUS","SUMMARY","IMPACT_LEVEL","DOC_LAYERS_EVALUATED"]
    },
    "web-researcher": {
      "required_fields": ["STATUS","SUMMARY","FILE_PATH","QUALITY_LEVEL","BLOCKING"]
    },
    "github-researcher": {
      "required_fields": ["STATUS","SUMMARY","FILE_PATH","QUALITY_LEVEL","BLOCKING"]
    },
    "skill-author": {
      "required_fields": ["STATUS","SUMMARY","CANDIDATE_ID"]
    }
  }
}
